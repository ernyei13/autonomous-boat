FROM ubuntu:22.04

# 1. System Environment
ENV DEBIAN_FRONTEND=noninteractive
ENV DEBCONF_NONINTERACTIVE_SEEN=true
ENV PATH="/home/ardupilot/.local/bin:${PATH}"

# 2. Install System Dependencies
# (Combined into one block to reduce layers and build time)
RUN apt-get update && apt-get install -y --no-install-recommends\
    git \
    sudo \
    build-essential \
    g++ \
    gcc \
    cmake \
    pkg-config \
    ccache \
    gawk \
    libtool \
    libxml2-dev \
    libxslt1-dev \
    zlib1g-dev \
    libblas-dev \
    liblapack-dev \
    libatlas-base-dev \
    genromfs \
    python3 \
    python3-dev \
    python3-pip \
    python3-venv \
    python3-opencv \
    python3-wxgtk4.0 \
    python3-matplotlib \
    python3-lxml \
    python3-pygame \
    python3-numpy \
    python3-psutil \
    python3-setuptools \
    python3-scipy \
    python3-serial \
    python3-yaml \
    python3-distutils \
    xterm \
    xfonts-base \
    libcsfml-dev \
    libsfml-dev \
    valgrind \
    screen \
    astyle \
    g++-arm-linux-gnueabihf \
    libglu1-mesa-dev \
    freeglut3-dev \
    mesa-common-dev \
    && rm -rf /var/lib/apt/lists/*

# 3. Create User
RUN useradd -m -s /bin/bash ardupilot && \
    usermod -aG sudo ardupilot && \
    echo 'ardupilot ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers

USER ardupilot
WORKDIR /home/ardupilot

# 4. Clone ArduPilot
RUN git clone --depth 1 --recursive --shallow-submodules https://github.com/ArduPilot/ardupilot.git
WORKDIR /home/ardupilot/ardupilot
RUN git submodule update --init --recursive --depth 1
# 5. Python Dependencies
# Upgrade pip first, then install requirements.
# Note: 'empy' version is pinned because ArduPilot build tools are sensitive to it.
RUN pip3 install --user --no-build-isolation "empy==3.3.4" && \
    pip3 install --user --upgrade pip setuptools wheel && \
    pip3 install --user --no-build-isolation \
        future \
        lxml \
        pymavlink \
        pyserial \
        MAVProxy \
        geocoder \
        ptyprocess \
        dronecan \
        flake8 \
        junitparser \
        wsproto \
        tabulate \
        pygame \
        intelhex \
        pexpect

# 6. Build ArduPilot (Baked-in Binary)
# We declare ARG here so changing VEHICLE_TYPE doesn't invalidate the cache of steps 1-5
ARG VEHICLE_TYPE=rover
ENV VEHICLE_TYPE=${VEHICLE_TYPE}

# Initialize waf and compile
RUN ./waf configure --board sitl && \
    ./waf ${VEHICLE_TYPE}

# 7. Setup Runtime
# Create data directory
RUN mkdir -p /home/ardupilot/ardupilot/data

# Expose ports
EXPOSE 5760 5501 5770 5511 5780 5521

# 8. Command
# We use 'sh -c' to ensure environment variables are expanded at runtime.
# This allows the command to see the ENV vars set by docker-compose.
CMD ["sh", "-c", "python3 /home/ardupilot/ardupilot/Tools/autotest/sim_vehicle.py  --vehicle=${VEHICLE_TYPE:-Rover} --instance=${INSTANCE:-0} --sysid=${SYSID_THISMAV:-0} --model=${MODEL:-powerboat} --speedup=${SPEEDUP:-1} --no-rebuild --no-mavproxy --sim-address=0.0.0.0 "]
