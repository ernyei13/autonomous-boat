FROM python:3.11-slim

# Prevent interactive prompts
ENV DEBIAN_FRONTEND=noninteractive
ENV DEBCONF_NONINTERACTIVE_SEEN=true
ENV PYTHONUNBUFFERED=1

# Install strict minimum system dependencies (No GUI libs needed)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    python3-dev \
    build-essential \
    iputils-ping \
    netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

# Install MAVProxy
RUN pip install --upgrade pip setuptools wheel && \
    pip install \
    future \
    PyYAML \
    mavproxy \
    pymavlink

# Create user
RUN useradd -m -s /bin/bash mavproxy && \
    mkdir -p /var/log/mavproxy && \
    chown -R mavproxy:mavproxy /var/log/mavproxy

USER root
RUN mkdir -p /home/mavproxy && chown -R mavproxy:mavproxy /home/mavproxy

USER mavproxy
WORKDIR /home/mavproxy

# We will mount start.sh via docker-compose and call it with bash
ENTRYPOINT ["/bin/bash", "/home/mavproxy/start.sh"]